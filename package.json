{
  "name": "luau-delivery",
  "version": "1.0.0",
  "description": "Secure, versioned Luau script delivery platform",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
